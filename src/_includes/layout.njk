<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>{{ title }} | Karol Sadkowski</title>

  <link rel="stylesheet" href="/css/styles.css">
  <link rel="icon" href="/favicon.ico" type="image/x-icon">
  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"
  >
</head>

<body>
  <header class="site-header">
    <div class="header-inner">
      <div class="site-brand">
        <a
          href="/"
          class="logo-link"
          aria-label="Karol Sadkowski homepage"
        >
          <img
            src="/assets/images/header-logo.png"
            alt=""
            class="header-logo"
            aria-hidden="true"
          >
        </a>

        <h1>
          <a href="/">Karol Ł. Sadkowski, M.Ed.</a>
        </h1>
      </div>

      <nav aria-label="Main navigation">
        <a
          href="/"
          class="{% if page.url == '/' %}active{% endif %}"
        >
          About
        </a>

        <a
          href="/bio.html"
          class="{% if page.url == '/bio.html' %}active{% endif %}"
        >
          Bio
        </a>

        <a
          href="/projects.html"
          class="{% if page.url == '/projects.html' %}active{% endif %}"
        >
          Projects
        </a>

        <a
          href="/values.html"
          class="{% if page.url == '/values.html' %}active{% endif %}"
        >
          Values
        </a>

        <a
          href="/photos.html"
          class="{% if page.url == '/photos.html' %}active{% endif %}"
        >
          Photos
        </a>

        <a
          href="https://www.linkedin.com/in/karolsadkowski/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
          title="LinkedIn"
        >
          <i class="fab fa-linkedin" aria-hidden="true"></i>
        </a>

        <a
          href="https://github.com/sadkowsk"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
          title="GitHub"
        >
          <i class="fab fa-github" aria-hidden="true"></i>
        </a>
      </nav>
    </div>
  </header>

  <main>
    {{ content | safe }}
  </main>

  <footer>
    <div class="footer-inner">
      <p class="copyright">
        Copyright &copy; 2026 Karol Ł. Sadkowski. All rights reserved.
        <button
          class="copyright-info-button"
          type="button"
          aria-label="Copyright and usage information"
          aria-haspopup="dialog"
          aria-controls="copyright-modal"
        >
          <span aria-hidden="true">i</span>
        </button>
      </p>

      <span class="footer-separator" aria-hidden="true">|</span>

      <div class="footer-update-group">
        <p class="last-updated">
          Updated: {{ lastUpdated }}.
        </p>

        <a
          href="https://github.com/sadkowsk/sadkowsk.github.io"
          class="footer-repo-link"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="View this site's repository on GitHub"
          title="View site repository on GitHub"
        >
          <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
        </a>
      </div>
    </div>
  </footer>

  <div
    class="copyright-modal-overlay"
    id="copyright-modal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="copyright-modal-title"
    aria-hidden="true"
  >
    <div class="copyright-modal" role="document">
      <button
        class="copyright-modal-close"
        type="button"
        aria-label="Close copyright and usage information"
      >
        <span aria-hidden="true">&times;</span>
      </button>

      <h2 id="copyright-modal-title">
        Copyright and Usage Notice
      </h2>

      <div class="copyright-modal-content">
        {{ copyrightNoticeHtml | safe }}
      </div>
    </div>
  </div>

  <script src="/assets/features/copyright-modal.js"></script>
</body>
</html>
